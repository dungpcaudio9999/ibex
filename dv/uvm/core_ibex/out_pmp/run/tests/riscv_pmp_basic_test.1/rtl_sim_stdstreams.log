ucli% # TCL file invoked from VCS's simv at run-time using this: -ucli -do <this file>
ucli% # Since we don't necessarily run each test in a different directory,
ucli% # we have to tell VCS where to put the waves. We do this with a
ucli% # SIM_DIR environment variable, which we prepend to the wave name. If
ucli% # SIM_DIR is not set, we just dump to the current directory.
ucli% if { [info exists ::env(SIM_DIR)] } {
    set sim_dir $::env(SIM_DIR)
} else {
    set sim_dir "."
}
